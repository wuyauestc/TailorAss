 #include <ipc/distance/edge_edge_mollifier.hpp>
 
 namespace ipc {
+namespace {
+// Preserve the same physical fixed-distance leaf under the undirected edge key.
+void canonicalize_normal_edge_pair(EdgeEdgeNormalCollision& collision)
+{
+    if (collision.edge0_id <= collision.edge1_id) { return; }
+    std::swap(collision.edge0_id, collision.edge1_id);
+    switch (collision.dtype) {
+    case EdgeEdgeDistanceType::EA0_EB1: collision.dtype=EdgeEdgeDistanceType::EA1_EB0; break;
+    case EdgeEdgeDistanceType::EA1_EB0: collision.dtype=EdgeEdgeDistanceType::EA0_EB1; break;
+    case EdgeEdgeDistanceType::EA_EB0: collision.dtype=EdgeEdgeDistanceType::EA0_EB; break;
+    case EdgeEdgeDistanceType::EA_EB1: collision.dtype=EdgeEdgeDistanceType::EA1_EB; break;
+    case EdgeEdgeDistanceType::EA0_EB: collision.dtype=EdgeEdgeDistanceType::EA_EB0; break;
+    case EdgeEdgeDistanceType::EA1_EB: collision.dtype=EdgeEdgeDistanceType::EA_EB1; break;
+    default: break; // symmetric 00/11/interior-interior/AUTO
+    }
+}
+} // namespace
 
